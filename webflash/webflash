#!/usr/bin/env python3
"""webflash: use the serial devices of the computer that has the flasher page open.

    webflash status                         pages, their devices, offered firmware
    webflash open [--baud 115200]           start the serial monitor (RX goes to a log file)
    webflash log [-n 40] [--follow SECS]    show the monitor log
    webflash send TEXT | --hex 94c3...      write to the open device
    webflash reset                          pulse RTS to restart the device
    webflash chip                           enter the bootloader and identify the chip
    webflash offer NAME 0x10000:app.bin     list firmware on the page for a manual flash
    webflash flash NAME [0x10000:app.bin]   flash an offer (or these parts) and restart
    webflash put FILE /geo/file.bin         copy a file to the device's SD card over the serial cable
    webflash ls [/geo] | rm PATH | crc PATH [--file FILE]   look at, delete, check files on the card
    webflash get PATH [FILE]                read a small file from the card
    webflash tone [RTTTL]                   play a tune on the device's buzzer

--client and --port pick a page and device when there is more than one.
"""

import argparse
import json
import sys
import time
import urllib.error
import urllib.request


def call(args, path, body=None, stream=False):
    request = urllib.request.Request(f"http://127.0.0.1:{args.server}/ctl/{path}")
    if body is not None:
        request.data = json.dumps(body).encode()
        request.add_header("Content-Type", "application/json")
    try:
        response = urllib.request.urlopen(request, timeout=None if stream else 30)
    except urllib.error.HTTPError as e:
        try:
            sys.exit("webflash: " + json.load(e)["error"])
        except (ValueError, KeyError):
            sys.exit(f"webflash: server answered {e.code}")
    except urllib.error.URLError as e:
        sys.exit(f"webflash: server is not reachable ({e.reason}); is webflash.service running?")
    return response if stream else json.load(response)


def target(args):
    return {k: v for k, v in (("client", args.client), ("port", args.port)) if v is not None}


def command(args, op, **op_args):
    """Run a command on the page, echo its output, return the result or exit."""
    body = dict(target(args), op=op, args=op_args, timeout=args.timeout)
    shown = -1
    for line in call(args, "cmd", body, stream=True):
        m = json.loads(line)
        if m["t"] == "log":
            print(m["text"], flush=True)
        elif m["t"] == "progress":
            percent = 100 * m["written"] // max(m["total"], 1)
            if percent != shown:
                shown = percent
                print(f"  part {m['file'] + 1}: {percent}%", flush=True)
        elif m["t"] == "reply":
            if not m["ok"]:
                sys.exit(f"webflash: {op} failed on {m['client']} device {m['port']}: {m['error']}")
            return m.get("result", {})
    sys.exit("webflash: the server closed the connection before the page replied")


def parts(specs):
    out = []
    for spec in specs:
        offset, _, path = spec.partition(":")
        if not path:
            sys.exit(f"webflash: expected OFFSET:FILE, got {spec}")
        out.append({"offset": int(offset, 0), "path": path})
    return out


def cmd_status(args):
    status = call(args, "status")
    if not status["clients"]:
        print("no page is connected")
    for c in status["clients"]:
        flags = [] if c["serial"] else ["no Web Serial"]
        flags += [] if c["remote"] else ["remote control off"]
        age = int(time.time() - c["since"])
        print(f"{c['id']}  {c['addr']}  up {age}s  {' '.join(flags)}\n    {c['agent']}")
        for p in c["ports"]:
            baud = f" {p['baud']} baud" if p["state"] == "open" else ""
            print(f"    device {p['id']}: {p['name']}  [{p['state']}{baud}]  log {p['log']}")
        if not c["ports"]:
            print("    no devices granted yet")
    for o in status["offers"]:
        files = ", ".join(f"{p['offset']:#x}:{p['path']}" for p in o["parts"])
        print(f"offer {o['name']}: {files}")
    print(f"raw bridge for the open device: socket://127.0.0.1:{status['bridge']}")


def cmd_open(args):
    command(args, "open", baud=args.baud)


def cmd_close(args):
    command(args, "close")


def cmd_reset(args):
    command(args, "reset")


def cmd_chip(args):
    for key, value in command(args, "chip").items():
        print(f"{key}: {value}")


def cmd_send(args):
    if args.hex:
        data = bytes.fromhex(args.hex)
    else:
        data = (args.text or "").encode() + (b"" if args.no_newline else b"\n")
    sent = call(args, "write", dict(target(args), hex=data.hex()))
    print(f"wrote {len(data)} bytes to {sent['client']} device {sent['port']}")


def cmd_log(args):
    picked = call(args, "pick?" + "&".join(f"{k}={v}" for k, v in target(args).items()))
    try:
        log = open(picked["log"], "rb")
    except FileNotFoundError:
        sys.exit(f"webflash: nothing received yet from {picked['client']} device {picked['port']}")
    lines = log.read().decode(errors="replace").splitlines(keepends=True)
    sys.stdout.write("".join(lines[-args.lines :]))
    until = time.time() + args.follow
    while time.time() < until:
        sys.stdout.write(log.read().decode(errors="replace"))
        sys.stdout.flush()
        time.sleep(0.25)


def cmd_offer(args):
    if args.remove:
        call(args, "offer", {"name": args.name, "remove": True})
    else:
        call(args, "offer", {"name": args.name, "parts": parts(args.parts), "note": args.note})


def cmd_flash(args):
    extra = {"parts": parts(args.parts), "note": args.note} if args.parts else {}
    result = command(args, "flash", name=args.name, baud=args.baud, eraseAll=args.erase_all, **extra)
    print(f"flashed {result['bytes']} bytes to {result['chip']}, device restarted")


class Files:
    """The file transfer of the device (see serialfiles.py), entered at 115200 baud and left again at the end."""

    def __init__(self, args, baud=0):
        import serialfiles

        self.args, self.lib, self.fast = args, serialfiles, False
        picked = call(args, "pick?" + "&".join(f"{k}={v}" for k, v in target(args).items()))
        args.client, args.port = picked["client"], picked["port"]
        self.monitor(115200)
        self.link = serialfiles.Link(call(args, "status")["bridge"])
        if not self.link.hello():
            sys.exit("webflash: the device does not answer the file transfer; does its firmware have it?")
        if baud and baud != 115200:
            self.link.ask(serialfiles.BAUD, baud.to_bytes(4, "little"))
            self.fast = True
            time.sleep(0.2)
            self.monitor(baud)
            self.link.connect()
            self.link.ask(serialfiles.STAT, b"/")

    def monitor(self, baud):
        """Has the page's monitor open at that speed."""
        for c in call(self.args, "status")["clients"]:
            for p in c["ports"]:
                if c["id"] == self.args.client and p["id"] == self.args.port:
                    if p["state"] == "open" and p.get("baud") == baud:
                        return
                    if p["state"] == "open":
                        command(self.args, "close")
        command(self.args, "open", baud=baud)

    def __enter__(self):
        return self

    def __exit__(self, kind, value, trace):
        try:
            self.link.ask(self.lib.EXIT, tries=2)
        except self.lib.Problem:
            pass  # it goes back by itself after 30 seconds of silence
        self.link.close()
        if self.fast:
            time.sleep(0.3)
            self.monitor(115200)
        if isinstance(value, self.lib.Problem):
            sys.exit(f"webflash: {value}")


def cmd_put(args):
    with Files(args, args.baud) as files:
        size, seconds = files.lib.put(files.link, args.file, args.path, resume=not args.fresh)
        print(f"saved {args.path}: {size:,} bytes in {seconds:.0f} s")
        if not args.no_check:
            _, answer = files.link.ask(files.lib.CRC, args.path.encode(), timeout=900, tries=1)
            there = int.from_bytes(answer[:4], "little")
            here = files.lib.crc_of_file(args.file)
            if there != here:
                sys.exit(f"webflash: the file on the card differs (CRC {there:08x}, here {here:08x})")
            print(f"checked: the file on the card is the same (CRC {here:08x})")


def cmd_ls(args):
    with Files(args) as files:
        _, answer = files.link.ask(files.lib.LIST, args.path.encode(), timeout=20, tries=2)
        sys.stdout.write(answer.decode(errors="replace"))


def cmd_rm(args):
    with Files(args) as files:
        files.link.ask(files.lib.DELETE, args.path.encode(), timeout=20, tries=2)
        print(f"deleted {args.path}")


def cmd_crc(args):
    with Files(args) as files:
        _, answer = files.link.ask(files.lib.CRC, args.path.encode(), timeout=900, tries=1)
        there, size = int.from_bytes(answer[:4], "little"), int.from_bytes(answer[4:12], "little")
        print(f"{args.path}: {size:,} bytes, CRC {there:08x}")
        if args.file:
            here = files.lib.crc_of_file(args.file)
            print("the same as " + args.file if here == there else f"DIFFERENT from {args.file} (CRC {here:08x})")
            if here != there:
                sys.exit(1)


def cmd_get(args):
    with Files(args) as files:
        data = files.lib.get(files.link, args.path)
        if args.file:
            with open(args.file, "wb") as f:
                f.write(data)
            print(f"{args.path}: {len(data):,} bytes to {args.file}")
        else:
            sys.stdout.buffer.write(data)


def cmd_tone(args):
    with Files(args) as files:
        _, answer = files.link.ask(files.lib.TONE, args.rtttl.encode(), tries=2)
        print("the buzzer plays it" if answer[:1] == b"\x01" else "no sound: sound is switched off on the device, or it has no buzzer")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--server", type=int, default=8377, help="server port on 127.0.0.1")
    parser.add_argument("--client", help="page id, e.g. c2 (default: the newest page with a device)")
    parser.add_argument("--port", type=int, help="device number on that page (default: the only or the open one)")
    parser.add_argument("--timeout", type=int, default=600, help="seconds to wait for the page")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(run=cmd_status)
    p = sub.add_parser("open")
    p.add_argument("--baud", type=int, default=115200)
    p.set_defaults(run=cmd_open)
    sub.add_parser("close").set_defaults(run=cmd_close)
    sub.add_parser("reset").set_defaults(run=cmd_reset)
    sub.add_parser("chip").set_defaults(run=cmd_chip)
    p = sub.add_parser("send")
    p.add_argument("text", nargs="?")
    p.add_argument("--hex")
    p.add_argument("--no-newline", action="store_true")
    p.set_defaults(run=cmd_send)
    p = sub.add_parser("log")
    p.add_argument("-n", "--lines", type=int, default=40)
    p.add_argument("--follow", type=float, default=0, metavar="SECS")
    p.set_defaults(run=cmd_log)
    p = sub.add_parser("offer")
    p.add_argument("name")
    p.add_argument("parts", nargs="*", metavar="OFFSET:FILE")
    p.add_argument("--note", default="")
    p.add_argument("--remove", action="store_true")
    p.set_defaults(run=cmd_offer)
    p = sub.add_parser("flash")
    p.add_argument("name")
    p.add_argument("parts", nargs="*", metavar="OFFSET:FILE")
    p.add_argument("--note", default="")
    p.add_argument("--baud", type=int, default=460800)
    p.add_argument("--erase-all", action="store_true", help="erase the whole flash first (wipes settings)")
    p.set_defaults(run=cmd_flash)

    p = sub.add_parser("put")
    p.add_argument("file")
    p.add_argument("path", help="where on the card, e.g. /geo/roads.bin")
    p.add_argument("--baud", type=int, default=921600)
    p.add_argument("--fresh", action="store_true", help="start over instead of going on with a part that is there")
    p.add_argument("--no-check", action="store_true", help="do not compare the file on the card afterwards")
    p.set_defaults(run=cmd_put)
    p = sub.add_parser("ls")
    p.add_argument("path", nargs="?", default="/")
    p.set_defaults(run=cmd_ls)
    p = sub.add_parser("rm")
    p.add_argument("path")
    p.set_defaults(run=cmd_rm)
    p = sub.add_parser("get", help="read a (small) file from the card")
    p.add_argument("path")
    p.add_argument("file", nargs="?")
    p.set_defaults(run=cmd_get)
    p = sub.add_parser("tone", help="play a tune on the buzzer, a test")
    p.add_argument("rtttl", nargs="?", default="test:d=8,o=6,b=180:c,e,g,c7")
    p.set_defaults(run=cmd_tone)
    p = sub.add_parser("crc")
    p.add_argument("path")
    p.add_argument("--file", help="a local file to compare with")
    p.set_defaults(run=cmd_crc)

    args = parser.parse_args()
    args.run(args)


if __name__ == "__main__":
    main()
